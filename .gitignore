# ── SSH host key (auto-generated, must stay private) ─────────────────────────
ssh_host_key

# ── User content (keep the directories, ignore their contents) ──────────────
videos/*
!videos/.gitkeep
output/*
!output/.gitkeep
subs/*
!subs/.gitkeep

# ── ffmpeg binaries (install via your package manager, do not commit) ────────
ffmpeg.exe
ffprobe.exe

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.DS_Store
Thumbs.db
desktop.ini

# ── Claude / AI meta ─────────────────────────────────────────────────────────
CLAUDE.md
.claude/
memory/
